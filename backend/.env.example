# Backend environment — copy to .env and fill in.
# Everything the app reads is listed here. Set all REQUIRED vars on the new
# host or the process will not start.

# ─── REQUIRED (app crashes at import without these) ──────────────────────────
# Atlas connection string + database name.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=myisraelrental
# Signing key for our own JWTs. Generate a fresh 48+ byte random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this invalidates every existing session (all users log out).
JWT_SECRET=

# ─── STRONGLY RECOMMENDED — durable media storage ────────────────────────────
# Without these, uploads fall back to LOCAL DISK, which is wiped on every
# redeploy on any container host. This is how a contract was already lost.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Google Sign-In ──────────────────────────────────────────────────────────
# OAuth 2.0 Web client ID (public, not a secret). Must match the frontend's
# REACT_APP_GOOGLE_CLIENT_ID. Blank disables Google sign-in (endpoint 503s).
# Add the production domain to "Authorized JavaScript origins" in Google Cloud.
GOOGLE_CLIENT_ID=

# ─── LLM features (translation, CSV column mapping, bulk extract) ────────────
# Blank disables them gracefully (CSV mapping falls back to fuzzy matching).
ANTHROPIC_API_KEY=

# ─── URLs / CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins permitted to call the API.
CORS_ORIGINS=https://myisraelrental.com,https://www.myisraelrental.com
FRONTEND_URL=https://myisraelrental.com
PLATFORM_PUBLIC_URL=https://myisraelrental.com
PUBLIC_API_URL=https://myisraelrental.com

# ─── Email (Postmark) ────────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_FROM_NAME=

# ─── Payments (PayPal) ───────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=
PAYPAL_ADMIN_EMAIL=

# ─── WhatsApp / SMS (Twilio) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID_CONTRACT_SIGNED=
TWILIO_CONTENT_SID_RENTER_MESSAGE=
WHATSAPP_ACCESS_TOKEN=
CONTACT_PHONE=

# ─── Deprecated ──────────────────────────────────────────────────────────────
# Replaced by ANTHROPIC_API_KEY (emergentintegrations was removed 2026-07-23).
# Kept only as a dormant fallback; safe to omit entirely on the new host.
# EMERGENT_LLM_KEY=
