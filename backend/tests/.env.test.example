# Template for tests/.env.test (which is gitignored). Copy this file to
# .env.test and fill in accounts that exist in your LOCAL dev database.
#
# WHY THIS FILE EXISTS. Without .env.test every TEST_* variable below is
# the empty string, so ~70 tests across test_bulk_upload, test_pricing_*,
# test_email_pipeline and test_admin_bulk_delete log in as "" and fail
# with "login failed". On a fresh machine that looks like seventy broken
# features; it is one missing file. Nothing told you that until now.
#
# The three role accounts are the ones the seeded local database already
# carries (test_security_audit.py hardcodes the same three). OWNER2 and
# RENTER2 are "the other party" in two-sided tests; register them with
# POST /api/auth/register against the local backend if they do not exist.
#
# Local throwaway accounts only. Never point these at production.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_OWNER_EMAIL=
TEST_OWNER_PASSWORD=
TEST_RENTER_EMAIL=
TEST_RENTER_PASSWORD=
TEST_OWNER2_EMAIL=
TEST_OWNER2_PASSWORD=
TEST_RENTER2_EMAIL=
TEST_RENTER2_PASSWORD=
# Where the live-server tests look for the backend. conftest.py probes it
# once and SKIPS those tests (with this URL in the reason) if nothing is
# listening, rather than failing them.
TEST_API_BASE=http://localhost:8001/api
