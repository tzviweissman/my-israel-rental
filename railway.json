{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "frontend-preview": {
      "build": {
        "dockerfilePath": "Dockerfile.preview"
      },
      "deploy": {
        "startCommand": "npx serve -s build -l $PORT",
        "healthcheckPath": "/",
        "healthcheckTimeout": 120,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  }
}

