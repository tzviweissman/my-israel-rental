      "property": {
        "rental_type": "long-term",
        "monthly_price": 5000
      },
      "expected": {
        "amount": 5000,
        "currency": "ILS",
        "per": "month",
        "holidays": []
      }
    },
    {
      "name": "long-term flat also listed for Sukkot, in a Sukkot context: the Sukkot price",
      "property": {
        "rental_type": "long-term",
        "monthly_price": 9000,
        "holiday_lump_price": 4000,
        "currency": "ILS",
        "holiday_tags": [
          "sukkot"
        ]
      },
      "holiday": "sukkot",
      "expected": {
        "amount": 4000,
