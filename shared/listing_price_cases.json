        "per": "holiday",
        "holidays": [
          "sukkot"
        ]
      }
    },
    {
      "name": "long-term flat also listed for Sukkot, no context: the monthly rent",
      "property": {
        "rental_type": "long-term",
        "monthly_price": 9000,
