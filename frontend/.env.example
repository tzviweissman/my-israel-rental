# Frontend environment — copy to .env and fill in.
# NOTE: Create React App inlines REACT_APP_* values into the JS bundle at
# BUILD time, so (a) they are public — never put a secret here, and (b) you
# must rebuild after changing any of them.

# Base URL of the API. No trailing slash; the app appends "/api".
REACT_APP_BACKEND_URL=https://myisraelrental.com

# Google Sign-In client ID — must be the SAME value as the backend's
# GOOGLE_CLIENT_ID. Blank hides the Google buttons (and their "or" dividers).
REACT_APP_GOOGLE_CLIENT_ID=

# PayPal client ID for the checkout button (public).
REACT_APP_PAYPAL_CLIENT_ID=

# Google Search Console site-verification token. Optional — when set, emits
# the <meta name="google-site-verification"> tag site-wide.
REACT_APP_GOOGLE_VERIFICATION=
