# Frontend environment — copy to .env and fill in.
# NOTE: Create React App inlines REACT_APP_* values into the JS bundle at
# BUILD time, so (a) they are public — never put a secret here, and (b) you
# must rebuild after changing any of them.

# Base URL of the API. No trailing slash; the app appends "/api".
REACT_APP_BACKEND_URL=https://myisraelrental.com

# Google Sign-In client ID — must be the SAME value as the backend's
# GOOGLE_CLIENT_ID. Blank hides the Google buttons (and their "or" dividers).
REACT_APP_GOOGLE_CLIENT_ID=

# PayPal client ID for the checkout button (public).
REACT_APP_PAYPAL_CLIENT_ID=

# Google Search Console site-verification token. Optional — when set, emits
# the <meta name="google-site-verification"> tag site-wide.
REACT_APP_GOOGLE_VERIFICATION=

# Business web addresses (<slug>.myisraelrental.com). See src/utils/businessHost.js.
# The apex the subdomains hang off.
REACT_APP_PUBLIC_SITE_HOST=myisraelrental.com
# "1" shows owners and share panels the subdomain form. Leave blank until the
# wildcard domain AND its certificate are live: the site sends HSTS with
# includeSubDomains, so a subdomain without a valid certificate will not open.
REACT_APP_BUSINESS_SUBDOMAINS=
# "path" (default) or "subdomain": which URL is canonical for search engines.
# Must match BUSINESS_CANONICAL on the backend.
REACT_APP_BUSINESS_CANONICAL=path

# Read by server.js at RUNTIME (not baked into the bundle): the apex whose
# subdomains are treated as business pages. Staging sets its own.
PUBLIC_SITE_HOST=myisraelrental.com
