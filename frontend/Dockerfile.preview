# Preview-only Dockerfile for the frontend-preview Railway service.
#
# Exists because Railway's Railpack builder, for this specific service,
# was auto-detecting `npm start` (craco start / webpack-dev-server) as the
# run command regardless of an explicit `deploy.startCommand` override via
# railway.json or the Railway API — confirmed via the `X-Powered-By: Express`
# response header (webpack-dev-server is Express-based; `serve` is not).
# A Dockerfile with an explicit CMD sidesteps Railpack's auto-detection
# entirely. The production frontend service is untouched and keeps using
# its existing Railpack/nixpacks.toml build path.
FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps
COPY . .
ENV CI=false
RUN npm run build

FROM node:20-slim
WORKDIR /app
# Pin to the same major/minor as frontend/package.json's "serve": "^14.2.4"
# dependency — an unpinned `npm install -g serve` pulled a newer major
# version whose CLI changed: `-l $PORT` now requires an explicit URI
# scheme and fails with "Unknown --listen endpoint scheme (protocol):
# undefined" on a bare port number.
RUN npm install -g serve@14.2.4
COPY --from=build /app/build ./build
COPY docker-start.sh /app/docker-start.sh
RUN chmod +x /app/docker-start.sh
EXPOSE 3000
CMD ["/app/docker-start.sh"]
