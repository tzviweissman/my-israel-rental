#!/bin/sh
# What goes to main must not have a site answering a rule its own rules list lacks (scripts/check-push-rules.mjs).
# Low disk (18 Nov 2026: 0 bytes free stopped commits, a push copy and the local database).
free_gb=$(df -Pk . 2>/dev/null | awk 'NR==2 {print int($4/1048576)}')
if [ -n "$free_gb" ] && [ "$free_gb" -lt 5 ]; then
  echo "" >&2
  echo "WARNING: only ${free_gb} GB free on this disk. A push copy needs a few GB, and at 0 commits and the local database stop." >&2
  echo "  See what takes space: git worktree list (old copies), then ask Tzvi which to remove (node scripts/remove-worktree.mjs <path>)." >&2
fi
while read local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  case "$remote_sha" in 0000000000000000000000000000000000000000) base="" ;; *) base="$remote_sha" ;; esac
  git cat-file -e "$base" 2>/dev/null || base=""
  node scripts/check-push-rules.mjs "$local_sha" $base || exit 1
  # A push whose last commit is a MERGE can skip a side (CLAUDE.md, Railway deploy, 28 Oct 2026):
  # the merge's own files decide. A plain run of commits is judged as a whole: on 19 Nov 2026
  # 532858bd (frontend change, then a backend-only last commit) built both, so warn only on a merge.
  # ponytail: one observed linear push; if a linear push is ever SKIPPED, drop the merge test.
  if [ -n "$base" ] && git cat-file -e "$local_sha^2" 2>/dev/null; then
    for side in backend frontend; do
      if [ -n "$(git diff --name-only "$base" "$local_sha" -- "$side/")" ] && [ -z "$(git diff --name-only "$local_sha^" "$local_sha" -- "$side/")" ]; then
        echo "" >&2
        echo "WARNING: this push changes $side/, but its last commit does not, so Railway will SKIP the $side deploy." >&2
        echo "  Fix: make the last commit one that touches $side/ (rebase it to the top), or after pushing" >&2
        echo "  check scripts/wait-deploy.mjs shows the $side built, not SKIPPED." >&2
      fi
    done
  fi
done
exit 0
